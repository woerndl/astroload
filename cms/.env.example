# Postgres connection string. Local dev uses the docker-compose service at the repo root.
DATABASE_URI=postgres://astroload:astroload@127.0.0.1:5432/astroload

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Astro frontend origin used by generatePageURL.
WEBSITE_URL=http://localhost:4321

# Resend transactional email. Optional. When unset, email is logged to the console.
# RESEND_API_KEY=re_...
# RESEND_FROM_ADDRESS=cms@example.com
# RESEND_FROM_NAME=Payload CMS

# S3-compatible object storage for Media. Optional. When unset, files write to local disk.
# Example below targets Hetzner Object Storage (Nuremberg). Swap region and endpoint
# for any S3-compatible provider.
# Note: Hetzner has no UI for CORS. Set CORS via aws-cli before uploads work in /admin.
# S3_BUCKET=
# S3_ENDPOINT=https://nbg1.your-objectstorage.com
# S3_REGION=nbg1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
