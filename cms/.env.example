# MongoDB connection string. Local dev uses the docker-compose service at the
# repo root. When several projects run side by side, renumber the host port
# in docker-compose.yml and here, and rename the database. Mongo creates any
# database the URI names, so a URI pointed at the wrong mongod creates or
# reuses a database there instead of failing.
DATABASE_URI=mongodb://127.0.0.1:27330/astroload

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Origin where Payload serves /admin. Must match the browser origin or
# Payload's csrf check rejects the admin session cookie.
SERVER_URL=http://localhost:3000

# Astro frontend origin used by generatePageURL.
WEBSITE_URL=http://localhost:4321

# Shared secret guarding the Astro /preview route. Must match web/.env.
# Generate with: openssl rand -hex 32
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE

# API keys the auth seed mints for the website. When unset, the seed generates
# fresh values and logs them. Pin both after the first seed so a reseed keeps
# the values web/.env already carries.
# PAYLOAD_READ_KEY=
# PAYLOAD_PREVIEW_KEY=

# Admin account the auth seed creates on an empty database. When unset, the
# demo credentials admin@example.com / admin1234 are used. Change them before
# the instance is reachable from outside.
# PAYLOAD_ADMIN_EMAIL=
# PAYLOAD_ADMIN_PASSWORD=

# Webhook POSTed when content the site shows changes: a publish, unpublish, or
# deletion of a published doc, and any change to globals, media, redirects, or
# forms. The first change in a burst sends a POST immediately. Later changes
# collapse into one POST at the end of each 5-minute window. Leave unset to
# skip, together with the Railway variables below. Any plain deploy hook
# works, such as Vercel or Coolify.
# Vercel:  https://api.vercel.com/v1/integrations/deploy/<hookId>/<branch>
# Coolify: https://coolify.example.com/api/v1/deploy?uuid=<id>&force=true
# DEPLOY_HOOK_URL=
# JSON body of the POST. Defaults to {"trigger":"cms-change"}.
# DEPLOY_HOOK_BODY=
# Request headers of the POST as a JSON object, for a hook that needs auth,
# for example {"Authorization":"Bearer <token>"}. They add to or replace the
# default Content-Type: application/json.
# DEPLOY_HOOK_HEADERS=

# Railway has no deploy hook URL. With these set, the CMS calls the Railway
# API on each content change to set CONTENT_BUILD_ID on the web service to a
# new value, and Railway rebuilds the service. The CMS then skips the POST to
# DEPLOY_HOOK_URL. Keep "Skipped Builds" off in the web service settings, or
# Railway deploys the cached image. The token is a project token of the web
# service's environment. Railway sets RAILWAY_PROJECT_ID and
# RAILWAY_ENVIRONMENT_ID in every service. A CMS outside that environment sets
# both by hand. The web service id can be a reference variable. Replace web
# with the name of the web service.
# DEPLOY_RAILWAY_TOKEN=
# DEPLOY_RAILWAY_SERVICE_ID=${{web.RAILWAY_SERVICE_ID}}

# Resend transactional email. Optional. When unset, email is logged to the console.
# RESEND_API_KEY=re_...
# RESEND_FROM_ADDRESS=cms@example.com
# RESEND_FROM_NAME=Payload CMS

# Where local-disk media is written when S3 is unset. Defaults to cms/media.
# Point it at a mounted volume in a container so uploads survive a redeploy.
# MEDIA_DIR=/data/media

# S3-compatible object storage for Media. Optional. When unset, files write to local disk.
# Example below targets Hetzner Object Storage (Nuremberg). Swap region and endpoint
# for any S3-compatible provider.
# Hetzner has no UI for CORS. Set CORS with aws-cli before uploads work in /admin.
# S3_BUCKET=
# S3_ENDPOINT=https://nbg1.your-objectstorage.com
# S3_REGION=nbg1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
