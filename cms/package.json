{
  "name": "@astroload/cms",
  "version": "0.0.0",
  "description": "Payload CMS for the astroload starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "check": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed.ts",
    "seed:auth": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seedAuth.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "vitest run"
  },
  "dependencies": {
    "@jhb.software/payload-pages-plugin": "0.8.0",
    "@payloadcms/db-mongodb": "3.91.0",
    "@payloadcms/email-resend": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-form-builder": "3.91.0",
    "@payloadcms/plugin-seo": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "graphql": "^16.8.1",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.19.18",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "cross-env": "^7.0.3",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.2",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.23.4",
    "pnpm": "^10"
  }
}
