{
  "name": "astroload",
  "version": "0.1.0",
  "description": "Astro 6 + Payload 3 + Postgres starter.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:cms": "pnpm --filter @astroload/cms dev",
    "dev:web": "pnpm --filter @astroload/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm --filter @astroload/cms lint",
    "check": "pnpm --filter @astroload/web check"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "^9 || ^10"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
