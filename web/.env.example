# Payload API keys minted by `pnpm --filter cms seed`. The seed logs the
# generated keys to stdout on first run unless PAYLOAD_READ_KEY and
# PAYLOAD_PREVIEW_KEY are pre-set in the cms env.
PAYLOAD_READ_KEY=
PAYLOAD_PREVIEW_KEY=

# Shared secret guarding the /preview route. Must match cms/.env.
# Generate with: openssl rand -hex 32
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE

# Where the Payload admin and API live. Defaults to http://localhost:3000.
CMS_URL=http://localhost:3000

# Public origin of this Astro app. Defaults to http://localhost:4321.
WEBSITE_URL=http://localhost:4321

# Optional Plausible domain (e.g. example.com). Leave blank in dev.
PLAUSIBLE_DOMAIN=

# Optional per-deploy build id, stamped into every page as
# <meta name="content-build-id">. Set it to a value that changes each deploy
# (e.g. the host's deploy id) so a same-commit redeploy busts cached HTML. See
# docs/astroload/maintenance.md.
CONTENT_BUILD_ID=
