# Payload API keys created by `pnpm --filter cms seed`, which logs them to
# stdout. Pin PAYLOAD_READ_KEY and PAYLOAD_PREVIEW_KEY in the cms
# env so a reseed keeps the values below valid.
PAYLOAD_READ_KEY=
PAYLOAD_PREVIEW_KEY=

# Shared secret guarding the /preview route. Must match cms/.env.
# Generate with: openssl rand -hex 32
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE

# Where the Payload admin and API live. Defaults to http://localhost:3000.
CMS_URL=http://localhost:3000

# Public origin of this Astro app. Defaults to http://localhost:4321.
WEBSITE_URL=http://localhost:4321

# Optional Umami website id. When set, pages load a cookieless Umami tracker
# through first-party proxy routes. Leave blank for no analytics.
UMAMI_WEBSITE_ID=

# Origin of the Umami instance behind the proxy routes. Defaults to Umami
# Cloud. Point it at a self-hosted instance to keep the same first-party
# setup. The web server reads it at run time, so a change needs a restart.
#UMAMI_HOST_URL=https://cloud.umami.is

# Comma-separated host names that redirect to ALIAS_REDIRECT_ORIGIN, for
# example the platform's generated host. The web server reads them at run time
# and fails to start when ALIAS_REDIRECT_ORIGIN is missing or is not an http
# or https URL. The redirect answers 302, or 301 when ALIAS_REDIRECT_PERMANENT
# is 1 or true. See docs/astroload/deployment.md.
#ALIAS_REDIRECT_HOSTS=web-production.up.railway.app
#ALIAS_REDIRECT_ORIGIN=https://www.example.com
#ALIAS_REDIRECT_PERMANENT=1

# Optional build id, written into every page as <meta name="content-build-id">.
# Set it to a value that changes each deploy (e.g. the host's deploy id) so a
# redeploy of the same commit does not reuse cached HTML. See
# docs/astroload/maintenance.md.
CONTENT_BUILD_ID=
