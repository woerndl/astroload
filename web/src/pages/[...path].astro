---
import type { InferGetStaticPropsType } from 'astro'

import { getStaticPaths as getCmsStaticPaths } from '../cms/getStaticPaths'
import { loadCatchAllPage } from '../cms/loadPage'
import { DEFAULT_LOCALE, LOCALE_URL_PREFIX } from '../cms/types'
import CollectionLayout from '../layout/collections/CollectionLayout.astro'

export const prerender = true

export async function getStaticPaths() {
  return LOCALE_URL_PREFIX ? [] : getCmsStaticPaths()
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

if (LOCALE_URL_PREFIX) {
  return new Response(null, { status: 404 })
}

const { path } = Astro.params
const loaded = await loadCatchAllPage({
  locale: DEFAULT_LOCALE,
  fullPath: path ? `/${path}` : '/',
  props: Astro.props as Partial<Props>,
  locals: Astro.locals,
})

if (!loaded) {
  return new Response(null, { status: 404 })
}
---

<CollectionLayout result={loaded.result} paths={loaded.paths} lang={DEFAULT_LOCALE} />
