---
import { getGlobalData } from '../cms/getGlobalData'
import { getPageByPath, type PageByPathResult } from '../cms/getPageByPath'
import { getStaticPathItems } from '../cms/getStaticPaths'
import { loadPageResult } from '../cms/loadPage'
import { pickLocale } from '../cms/pickLocale'
import { DEFAULT_LOCALE, LOCALE_URL_PREFIX, type LocalePaths } from '../cms/types'
import CollectionLayout from '../layout/collections/CollectionLayout.astro'

// Single-locale prerenders the home page at the site root. Multi-locale
// redirects to the locale home, which needs the request, so prerenderOverrides
// in astro.config.mjs flips this route to on-demand in that mode.
export const prerender = true

const localeRedirect = LOCALE_URL_PREFIX
  ? `/${pickLocale(Astro.url.pathname, Astro.request.headers.get('accept-language'))}`
  : null
if (localeRedirect) {
  // The target depends on Accept-Language, so shared caches must not reuse
  // it across users, and a 301 would let caches pin one visitor's language.
  // Astro.redirect cannot set headers, so the Response is built by hand.
  return new Response(null, {
    status: 302,
    headers: {
      'Cache-Control': 'no-store',
      Location: localeRedirect,
      Vary: 'Accept-Language',
    },
  })
}

// Kick off global data now so it overlaps the page fetch. The layout awaits
// the same Astro.locals memo (see getGlobalData).
const globalData = getGlobalData({ locale: DEFAULT_LOCALE, preview: false, locals: Astro.locals })

let result: PageByPathResult | null
let paths: LocalePaths | undefined

if (import.meta.env.DEV) {
  // Resolve the home page directly by path so dev navigation skips the
  // full static-paths scan the prerendered build amortizes.
  const found = await getPageByPath('/')
  result = found
  paths = found?.paths
} else {
  // Prerendered build: getStaticPaths already scanned every path, so reusing the
  // snapshot here is free.
  const items = await getStaticPathItems()
  const home = items.find((item) => item.paths[DEFAULT_LOCALE] === '/')
  result = home ? await loadPageResult(home.collection, home.id, DEFAULT_LOCALE) : null
  paths = home?.paths
}

if (!result) {
  // A 404 renders no layout, so nothing awaits the global-data fetch kicked
  // off above. Swallow it so a globals failure can't turn this into a 500.
  void globalData.catch(() => {})
  return new Response(null, { status: 404 })
}
await globalData
---

<CollectionLayout result={result} paths={paths} lang={DEFAULT_LOCALE} />
