---
import { getHomeLocales, getStaticPathItems } from '../cms/getStaticPaths'
import { loadCatchAllPage } from '../cms/loadPage'
import { pickLocale } from '../cms/pickLocale'
import { isTemplatedPage } from '../cms/templatedPages'
import { DEFAULT_LOCALE, LOCALE_URL_PREFIX, type Locale } from '../cms/types'
import CollectionLayout from '../layout/collections/CollectionLayout.astro'
import TemplatedBody from '../layout/routes/TemplatedBody.astro'

// Single-locale prerenders the home page at the site root. Multi-locale
// redirects to the locale home, which needs the request, so prerenderOverrides
// in astro.config.mjs flips this route to on-demand in that mode.
export const prerender = true

if (LOCALE_URL_PREFIX) {
  const homes: Locale[] = import.meta.env.DEV
    ? await getHomeLocales(Astro.locals)
    : import.meta.env.HOME_LOCALES
  if (homes.length === 0) {
    return new Response(null, { status: 404, headers: { 'Cache-Control': 'no-store' } })
  }
  const wanted = pickLocale(Astro.url.pathname, Astro.request.headers.get('accept-language'))
  const locale = homes.includes(wanted) ? wanted : homes[0]
  // The target depends on Accept-Language, so shared caches must not reuse it
  // across visitors, and a 301 would let caches keep one visitor's language.
  // Astro.redirect does not set headers, so the Response is built by hand.
  return new Response(null, {
    status: 302,
    headers: {
      'Cache-Control': 'no-store',
      Location: `/${locale}`,
      Vary: 'Accept-Language',
    },
  })
}

const home = import.meta.env.DEV
  ? {}
  : (await getStaticPathItems()).find((item) => item.paths[DEFAULT_LOCALE] === '/')
if (!home) throw new Error('the CMS lists no published home page')

const loaded = await loadCatchAllPage({
  locale: DEFAULT_LOCALE,
  fullPath: '/',
  props: home,
  locals: Astro.locals,
})

if (!loaded) {
  return new Response(null, { status: 404 })
}
---

{isTemplatedPage(loaded.result) ? (
  <TemplatedBody result={loaded.result} paths={loaded.paths} lang={DEFAULT_LOCALE} />
) : (
  <CollectionLayout result={loaded.result} paths={loaded.paths} lang={DEFAULT_LOCALE} />
)}
