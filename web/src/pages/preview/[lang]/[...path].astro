---
import { timingSafeEqual } from 'node:crypto'

import { PREVIEW_SECRET } from 'astro:env/server'

import { getPageByPath } from '../../../cms/getPageByPath'
import { previewPayloadSDK } from '../../../cms/previewSdk'
import { isLocale } from '../../../cms/types'
import CollectionLayout from '../../../layout/collections/CollectionLayout.astro'

export const prerender = false

const expectedSecret = Buffer.from(PREVIEW_SECRET)

function isValidSecret(supplied: string | null): boolean {
  if (!supplied) return false
  const a = Buffer.from(supplied)
  if (a.length !== expectedSecret.length) return false
  return timingSafeEqual(a, expectedSecret)
}

const previewResponseHeaders = {
  'Cache-Control': 'no-store',
  'X-Robots-Tag': 'noindex, nofollow',
  'Referrer-Policy': 'no-referrer',
}

const supplied = Astro.url.searchParams.get('previewSecret')
if (!isValidSecret(supplied)) {
  return new Response('Forbidden', { status: 403, headers: previewResponseHeaders })
}

const { lang, path } = Astro.params
if (!isLocale(lang)) {
  return new Response(null, { status: 404, headers: previewResponseHeaders })
}

const fullPath = path ? `/${lang}/${path}` : `/${lang}`
let result: Awaited<ReturnType<typeof getPageByPath>>
try {
  result = await getPageByPath(fullPath, { preview: true, sdk: previewPayloadSDK })
} catch {
  return new Response(null, { status: 500, headers: previewResponseHeaders })
}
if (!result) {
  return new Response(null, { status: 404, headers: previewResponseHeaders })
}

for (const [name, value] of Object.entries(previewResponseHeaders)) {
  Astro.response.headers.set(name, value)
}
---

{/* paths feeds the language switcher. PreviewNav rewrites the switch target
    back into /preview. SEOMetadata suppresses alternates in preview. */}
<CollectionLayout result={result} paths={result.paths} lang={lang} preview={true} />
