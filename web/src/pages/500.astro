---
import { getGlobalData } from '../cms/getGlobalData'
import { pickLocale } from '../cms/pickLocale'
import { stripLocalePath } from '../cms/types'
import LayerOrder from '../components/LayerOrder.astro'
import MainContent from '../components/MainContent.astro'
import SkipLink from '../components/SkipLink.astro'
import Layout from '../layout/Layout.astro'

// Rendered on demand so Astro.url.pathname holds the requested URL and the
// locale can be picked from it.
export const prerender = false

const lang = pickLocale(Astro.url.pathname, Astro.request.headers.get('accept-language'))
const homeHref = stripLocalePath(`/${lang}`)

// A CMS outage is a likely cause of a 500, so a failed labels fetch renders
// the fallback branch below. Keyed by string so a locale without an entry
// falls back to en.
const fallback: Record<string, { title: string; description: string; homePageButton: string }> = {
  de: {
    title: 'Serverfehler',
    description: 'Ein unerwarteter Fehler ist aufgetreten. Bitte versuchen Sie es später erneut.',
    homePageButton: 'Zur Startseite',
  },
  en: {
    title: 'Server error',
    description: 'An unexpected error occurred. Please try again later.',
    homePageButton: 'Go to the home page',
  },
}

let cmsLabels: { title: string; description: string; homePageButton: string } | null = null
try {
  const { labels } = await getGlobalData({ locale: lang, preview: false, locals: Astro.locals })
  cmsLabels = labels.serverError
} catch (error) {
  console.error('500 page renders its fallback, the labels fetch failed:', error)
}
const { title, description, homePageButton } = cmsLabels ?? fallback[lang] ?? fallback.en
---

{cmsLabels ? (
  <Layout title={title} description={description} lang={lang}>
    <section class="message">
      <h1>{title}</h1>
      <p>{description}</p>
      <a href={homeHref} class="button">
        {homePageButton}
      </a>
    </section>
  </Layout>
) : (
  <html lang={lang}>
    <head>
      <meta charset="utf-8" />
      <LayerOrder />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta name="robots" content="noindex" />
      <title>{title}</title>
    </head>
    <body class="fallback">
      <SkipLink lang={lang} />
      <MainContent>
        <h1>{title}</h1>
        <p>{description}</p>
        <p>
          <a href={homeHref}>{homePageButton}</a>
        </p>
      </MainContent>
    </body>
  </html>
)}

<style>
  @layer components {
    .message {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
      padding-block: 6rem;
      text-align: center;
    }

    .button {
      display: inline-flex;
      align-items: center;
      padding: 0.5rem 1rem;
      border-radius: 0.375rem;
      background: var(--color-accent);
      color: var(--color-on-accent);
    }

    .button:hover {
      background: var(--color-accent-hover);
    }

    .fallback {
      padding: 6rem 1rem;
      font-family: system-ui, sans-serif;
      text-align: center;
    }
  }
</style>
