---
import type { InferGetStaticPropsType } from 'astro'

import { getStaticPaths as getCmsStaticPaths } from '../../cms/getStaticPaths'
import { loadCatchAllPage } from '../../cms/loadPage'
import { isLocale, LOCALE_URL_PREFIX } from '../../cms/types'
import CollectionLayout from '../../layout/collections/CollectionLayout.astro'

export const prerender = true

export async function getStaticPaths() {
  return LOCALE_URL_PREFIX ? getCmsStaticPaths() : []
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { lang, path } = Astro.params
if (!LOCALE_URL_PREFIX || !isLocale(lang)) {
  return new Response(null, { status: 404 })
}

const loaded = await loadCatchAllPage({
  locale: lang,
  fullPath: path ? `/${lang}/${path}` : `/${lang}`,
  props: Astro.props as Partial<Props>,
  locals: Astro.locals,
})

if (!loaded) {
  return new Response(null, { status: 404 })
}
---

<CollectionLayout result={loaded.result} paths={loaded.paths} lang={lang} />
