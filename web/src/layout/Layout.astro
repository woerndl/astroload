---
import { ClientRouter } from 'astro:transitions'

import { getGlobalData } from '../cms/getGlobalData'
import type { Locale, PreviewContext } from '../cms/types'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import LivePreviewListener from '../components/LivePreviewListener.astro'
import PreviewToolbar from '../components/PreviewToolbar.astro'
import '../styles/app.css'

interface Props {
  title: string
  description?: string
  lang: Locale
  preview?: PreviewContext
}

const { title, description, lang, preview } = Astro.props
const { header, footer, labels } = await getGlobalData({ locale: lang, preview: false })
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <ClientRouter />
  </head>
  <body class="bg-white text-gray-900 antialiased">
    {preview && <PreviewToolbar collection={preview.collection} id={preview.id} labels={labels.preview} />}
    <Header header={header} lang={lang} />
    <main class="mx-auto max-w-3xl px-4 py-12">
      <slot />
    </main>
    <Footer footer={footer} />
    {preview && <LivePreviewListener />}
  </body>
</html>
