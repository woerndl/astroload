---
import type { Media } from '@astroload/cms/src/payload-types'
import { CONTENT_BUILD_ID } from 'astro:env/server'
import { ClientRouter } from 'astro:transitions'

import { getGlobalData } from '../cms/getGlobalData'
import type { PageByPathResult } from '../cms/getPageByPath'
import type { Locale, LocalePaths, PreviewContext } from '../cms/types'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import JsonLd from '../components/JsonLd.astro'
import LivePreviewListener from '../components/LivePreviewListener.astro'
import PreviewNav from '../components/PreviewNav.astro'
import PreviewToolbar from '../components/PreviewToolbar.astro'
import SEOMetadata from '../components/SEOMetadata.astro'
import Umami from '../components/Umami.astro'
import '../styles/app.css'

interface Props {
  title: string
  description?: string
  image?: Media | null
  result?: PageByPathResult
  lang: Locale
  paths?: LocalePaths
  preview?: PreviewContext
}

const { title, description, image, result, lang, paths, preview } = Astro.props
const { header, footer, labels, siteSettings } = await getGlobalData({
  locale: lang,
  preview: Boolean(preview),
  locals: Astro.locals,
})
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {CONTENT_BUILD_ID && <meta name="content-build-id" content={CONTENT_BUILD_ID} />}
    <SEOMetadata
      lang={lang}
      collection={result?.collection}
      paths={paths}
      title={title}
      description={description}
      image={image}
      siteSettings={siteSettings}
      preview={Boolean(preview)}
    />
    {result && (
      <JsonLd
        result={result}
        lang={lang}
        pathname={Astro.url.pathname}
        siteSettings={siteSettings}
      />
    )}
    {/* Preview is editor traffic, keep it out of the stats. */}
    {!preview && <Umami />}
    <ClientRouter />
  </head>
  <body class="bg-white text-gray-900 antialiased">
    {preview && <PreviewToolbar collection={preview.collection} id={preview.id} labels={labels.preview} />}
    <Header header={header} lang={lang} paths={paths} labels={labels.global} />
    <main class="mx-auto max-w-3xl px-4 py-12">
      <slot />
    </main>
    <Footer footer={footer} />
    {preview && <PreviewNav />}
    {preview && <LivePreviewListener />}
  </body>
</html>
