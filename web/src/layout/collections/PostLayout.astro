---
import type { Author } from '@astroload/cms/src/payload-types'

import type { PageByPathResult } from '../../cms/getPageByPath'
import { resolveSeo } from '../../cms/resolveSeo'
import { isPopulated, type Locale, type LocalePaths, type PreviewContext } from '../../cms/types'
import Img from '../../components/Img.astro'
import LexicalContent from '../../components/lexical/LexicalContent.astro'
import { formatDate } from '../../lib/format'
import { CONTENT_COLUMN_SIZES } from '../contentColumn'
import Layout from '../Layout.astro'

interface Props {
  result: Extract<PageByPathResult, { collection: 'posts' }>
  lang: Locale
  paths?: LocalePaths
  preview?: PreviewContext
}

const { result, lang, paths, preview } = Astro.props
const { data } = result

const cover = isPopulated(data.image) ? data.image : null
const authors = (data.authors ?? []).filter((a): a is Author => isPopulated(a))
const publishedAt = data.publishedAt ? formatDate(data.publishedAt, lang) : null
const seo = resolveSeo(data)
---

<Layout
  title={seo.title}
  description={seo.description}
  image={seo.image ?? cover}
  result={result}
  lang={lang}
  paths={paths}
  preview={preview}
>
  <article>
    <header class="header">
      <h1>{data.title}</h1>
      <p class="excerpt">{data.excerpt}</p>
      {(authors.length > 0 || publishedAt) && (
        <p class="meta">
          {authors.map((a) => a.name).join(', ')}
          {authors.length > 0 && publishedAt && ' · '}
          {publishedAt}
        </p>
      )}
    </header>
    {cover && <Img image={cover} size="lg" class="cover" priority sizes={CONTENT_COLUMN_SIZES} />}
    <LexicalContent content={data.content} />
  </article>
</Layout>

<style>
  @layer components {
    .header {
      margin-bottom: 2rem;
    }

    .excerpt {
      margin-top: 0.75rem;
      color: var(--color-text-muted);
    }

    .meta {
      margin-top: 0.5rem;
      color: var(--color-text-muted);
    }

    .cover {
      inline-size: 100%;
      margin-bottom: 2rem;
    }
  }
</style>
