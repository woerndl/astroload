---
import type { Author, Post } from '@astroload/cms/src/payload-types'

import { resolveSeo } from '../../cms/resolveSeo'
import { isPopulated, type Locale, type LocalePaths, type PreviewContext } from '../../cms/types'
import Img from '../../components/Img.astro'
import LexicalContent from '../../components/lexical/LexicalContent.astro'
import Layout from '../Layout.astro'

interface Props {
  data: Post
  lang: Locale
  paths?: LocalePaths
  preview?: PreviewContext
}

const { data, lang, paths, preview } = Astro.props

const cover = isPopulated(data.image) ? data.image : null
const authors = (data.authors ?? []).filter((a): a is Author => isPopulated(a))
const publishedAt = data.publishedAt
  ? new Date(data.publishedAt).toLocaleDateString(lang)
  : null
const seo = resolveSeo(data)
---

<Layout
  title={seo.title}
  description={seo.description}
  image={seo.image ?? cover}
  result={{ collection: 'posts', data }}
  lang={lang}
  paths={paths}
  preview={preview}
>
  <article>
    <header class="mb-8">
      <h1 class="text-3xl font-semibold">{data.title}</h1>
      <p class="mt-3 text-gray-600">{data.excerpt}</p>
      {(authors.length > 0 || publishedAt) && (
        <p class="mt-2 text-gray-600">
          {authors.map((a) => a.name).join(', ')}
          {authors.length > 0 && publishedAt && ' · '}
          {publishedAt}
        </p>
      )}
    </header>
    {cover && <Img image={cover} size="lg" class="mb-8 w-full" loading="eager" />}
    <LexicalContent content={data.content} />
  </article>
</Layout>
