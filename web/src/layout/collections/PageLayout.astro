---
import type { PageByPathResult } from '../../cms/getPageByPath'
import { getGlobalData } from '../../cms/getGlobalData'
import { resolveSeo } from '../../cms/resolveSeo'
import type { Locale, LocalePaths, PreviewContext } from '../../cms/types'
import SectionBlock from '../../components/SectionBlock.astro'
import Layout from '../Layout.astro'

interface Props {
  result: Extract<PageByPathResult, { collection: 'pages' }>
  lang: Locale
  paths?: LocalePaths
  preview?: PreviewContext
}

const { result, lang, paths, preview } = Astro.props
const { data } = result
const sections = data.sections ?? []
const seo = resolveSeo(data)

// Blocks render in Layout's slot, evaluated in this scope before Layout's
// frontmatter, so Layout's labels can't reach them as props. Passing
// Astro.locals shares one request-scoped fetch with Layout (see getGlobalData).
const { labels } = await getGlobalData({
  locale: lang,
  preview: Boolean(preview),
  locals: Astro.locals,
})
---

<Layout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  result={result}
  lang={lang}
  paths={paths}
  preview={preview}
>
  <article>
    <h1>{data.title}</h1>
    <div class="sections page-sections">
      {sections.map((block) => (
        <SectionBlock block={block} lang={lang} labels={labels} />
      ))}
    </div>
  </article>
</Layout>

<style>
  @layer components {
    .sections {
      margin-top: 2rem;
    }

    /* A rich text section renders its paragraphs without a wrapper, so this
       rule spaces every direct child. :where() keeps the specificity at zero,
       so a block's own margin wins. */
    :global(:where(.page-sections > :not(:last-child))) {
      margin-block-end: 1.5rem;
    }
  }
</style>
