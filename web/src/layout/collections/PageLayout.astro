---
import type { Page } from '@astroload/cms/src/payload-types'

import { getGlobalData } from '../../cms/getGlobalData'
import { resolveSeo } from '../../cms/resolveSeo'
import type { Locale, LocalePaths, PreviewContext } from '../../cms/types'
import SectionBlock from '../../components/SectionBlock.astro'
import Layout from '../Layout.astro'

interface Props {
  data: Page
  lang: Locale
  paths?: LocalePaths
  preview?: PreviewContext
}

const { data, lang, paths, preview } = Astro.props
const sections = data.sections ?? []
const seo = resolveSeo(data)

// Blocks render in this slot, outside Layout's scope, so they need their own
// labels. The fetch is served from the same request cache Layout primes.
const { labels } = await getGlobalData({ locale: lang, preview: Boolean(preview) })
---

<Layout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  result={{ collection: 'pages', data }}
  lang={lang}
  paths={paths}
  preview={preview}
>
  <article>
    <h1 class="text-3xl font-semibold">{data.title}</h1>
    <div class="mt-8 space-y-6">
      {sections.map((block) => <SectionBlock block={block} lang={lang} labels={labels} />)}
    </div>
  </article>
</Layout>
