---
import type { PageByPathResult } from '../../cms/getPageByPath'
import { resolveSeo } from '../../cms/resolveSeo'
import { isPopulated, type Locale, type LocalePaths, type PreviewContext } from '../../cms/types'
import Img from '../../components/Img.astro'
import LexicalContent from '../../components/lexical/LexicalContent.astro'
import Layout from '../Layout.astro'

interface Props {
  result: Extract<PageByPathResult, { collection: 'authors' }>
  lang: Locale
  paths?: LocalePaths
  preview?: PreviewContext
}

const { result, lang, paths, preview } = Astro.props
const { data } = result

const photo = isPopulated(data.photo) ? data.photo : null
const seo = resolveSeo(data)
---

<Layout
  title={seo.title}
  description={seo.description}
  image={seo.image ?? photo}
  result={result}
  lang={lang}
  paths={paths}
  preview={preview}
>
  <article>
    <header class="flex flex-col items-start gap-4 sm:flex-row sm:items-center">
      {photo && (
        <Img image={photo} size="sm" class="h-24 w-24 rounded-full object-cover" sizes="96px" />
      )}
      <div>
        <h1 class="text-3xl font-semibold">{data.name}</h1>
        {data.role && <p class="mt-1 text-gray-600">{data.role}</p>}
      </div>
    </header>
    {data.bio && (
      <div class="mt-8">
        <LexicalContent content={data.bio} />
      </div>
    )}
  </article>
</Layout>
