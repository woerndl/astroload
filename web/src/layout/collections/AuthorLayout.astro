---
import type { PageByPathResult } from '../../cms/getPageByPath'
import { resolveSeo } from '../../cms/resolveSeo'
import { isPopulated, type Locale, type LocalePaths, type PreviewContext } from '../../cms/types'
import Img from '../../components/Img.astro'
import LexicalContent from '../../components/lexical/LexicalContent.astro'
import Layout from '../Layout.astro'

interface Props {
  result: Extract<PageByPathResult, { collection: 'authors' }>
  lang: Locale
  paths?: LocalePaths
  preview?: PreviewContext
}

const { result, lang, paths, preview } = Astro.props
const { data } = result

const photo = isPopulated(data.photo) ? data.photo : null
const seo = resolveSeo(data)
---

<Layout
  title={seo.title}
  description={seo.description}
  image={seo.image ?? photo}
  result={result}
  lang={lang}
  paths={paths}
  preview={preview}
>
  <article>
    <header class="header">
      {photo && <Img image={photo} size="sm" class="photo" sizes="96px" />}
      <div>
        <h1>{data.name}</h1>
        {data.role && <p class="role">{data.role}</p>}
      </div>
    </header>
    {data.bio && (
      <div class="bio">
        <LexicalContent content={data.bio} />
      </div>
    )}
  </article>
</Layout>

<style>
  @layer components {
    .header {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    @media (width >= 40rem) {
      .header {
        flex-direction: row;
        align-items: center;
      }
    }

    .photo {
      inline-size: 6rem;
      block-size: 6rem;
      border-radius: 50%;
      object-fit: cover;
    }

    .role {
      margin-top: 0.25rem;
      color: var(--color-text-muted);
    }

    .bio {
      margin-top: 2rem;
    }
  }
</style>
