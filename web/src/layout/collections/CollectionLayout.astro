---
import type { PageByPathResult } from '../../cms/getPageByPath'
import type { Locale, LocalePaths } from '../../cms/types'

import PageLayout from './PageLayout.astro'
import PostLayout from './PostLayout.astro'

interface Props {
  result: PageByPathResult
  paths?: LocalePaths
  lang: Locale
  preview?: boolean
}

const { result, paths, lang, preview = false } = Astro.props
const previewCtx = preview ? { collection: result.collection, id: result.data.id } : undefined
---

{result.collection === 'pages' ? (
  <PageLayout result={result} lang={lang} paths={paths} preview={previewCtx} />
) : (
  <PostLayout result={result} lang={lang} paths={paths} preview={previewCtx} />
)}
