---
import type { PageByPathResult } from '../../cms/getPageByPath'
import type { Locale } from '../../cms/types'

import AuthorLayout from './AuthorLayout.astro'
import PageLayout from './PageLayout.astro'
import PostLayout from './PostLayout.astro'

interface Props {
  result: PageByPathResult
  lang: Locale
  preview?: boolean
}

const { result, lang, preview = false } = Astro.props
const previewCtx = preview ? { collection: result.collection, id: result.data.id } : undefined
---

{
  result.collection === 'pages' ? (
    <PageLayout data={result.data} lang={lang} preview={previewCtx} />
  ) : result.collection === 'posts' ? (
    <PostLayout data={result.data} lang={lang} preview={previewCtx} />
  ) : (
    <AuthorLayout data={result.data} lang={lang} preview={previewCtx} />
  )
}
