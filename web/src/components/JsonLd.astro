---
import type { Author, SiteSetting } from '@astroload/cms/src/payload-types'
import { Schema } from 'astro-seo-schema'
import type { Distance, Graph, ImageObject, Thing, WebPage, WebSite } from 'schema-dts'

import type { PageByPathResult } from '../cms/getPageByPath'
import { articleLd, organizationLd, personLd, profilePageLd } from '../cms/structuredData'
import { isPopulated, type Locale } from '../cms/types'
import { absoluteSiteURL, versionedMediaURL } from '../cms/urls'
import { localePath } from '../lib/localePath'

interface Props {
  result: PageByPathResult
  lang: Locale
  pathname: string
  siteSettings: SiteSetting
}

const { result, lang, pathname, siteSettings } = Astro.props

const siteOrigin = new URL(absoluteSiteURL('/')).origin
const homePath = localePath(lang, '/')
const homeURL = `${siteOrigin}${homePath}`
const pageURL = absoluteSiteURL(pathname)

const defaultImage = isPopulated(siteSettings.defaultSeo?.image)
  ? siteSettings.defaultSeo.image
  : null

function mediaURL(
  media: { url?: string | null; updatedAt?: string | null } | null | undefined,
): string | undefined {
  if (!media?.url) return undefined
  return versionedMediaURL(media.url, media.updatedAt)
}

const isHome = pathname === homePath || pathname === `${homePath}/`

const graph: Thing[] = []

// The builders in web/src/cms/structuredData.ts accept more fields than these
// calls pass. Before passing a field, show its data on the page, unless
// docs/astroload/conventions.md lists the field as an exception.
const organization = organizationLd({
  name: siteSettings.siteName,
  url: siteOrigin,
  logo: mediaURL(defaultImage),
})

const webSite: WebSite = {
  '@type': 'WebSite',
  name: siteSettings.siteName,
  url: siteOrigin,
  inLanguage: lang,
}

if (isHome) {
  graph.push(webSite, organization)
} else if (result.collection === 'posts') {
  const post = result.data
  const authors = (post.authors ?? []).filter((a): a is Author => isPopulated(a))
  const cover = isPopulated(post.image) ? post.image : null
  const ogVariant = cover?.sizes?.og
  let image: string | ImageObject | undefined
  if (ogVariant?.url && ogVariant.width && ogVariant.height) {
    image = {
      '@type': 'ImageObject',
      url: versionedMediaURL(ogVariant.url, cover?.updatedAt),
      // schema-dts types these as Distance/QuantitativeValue, but Google expects a bare integer.
      width: ogVariant.width as unknown as Distance,
      height: ogVariant.height as unknown as Distance,
    }
  } else {
    image = mediaURL(cover)
  }
  graph.push(
    articleLd({
      headline: post.title,
      url: pageURL,
      description: post.excerpt,
      inLanguage: lang,
      datePublished: post.publishedAt ?? undefined,
      dateModified: post.updatedAt,
      authors: authors.map((a) => ({
        name: a.name,
        url: a.path ? absoluteSiteURL(a.path) : undefined,
      })),
      images: image ? [image] : [],
      publisher: organization,
    }),
  )
} else if (result.collection === 'authors') {
  const author = result.data
  const photo = isPopulated(author.photo) ? author.photo : null
  const person = personLd({
    name: author.name,
    url: pageURL,
    image: mediaURL(photo),
    jobTitle: author.role ?? undefined,
  })
  graph.push(profilePageLd({ url: pageURL, person }))
} else if (result.collection === 'pages') {
  const webPage: WebPage = {
    '@type': 'WebPage',
    name: result.data.title ?? siteSettings.siteName,
    url: pageURL,
    inLanguage: lang,
    isPartOf: { '@type': 'WebSite', url: homeURL, name: siteSettings.siteName },
  }
  graph.push(webPage)
}

const payload: Graph = {
  '@context': 'https://schema.org',
  '@graph': graph,
}
---

<Schema item={payload} />
