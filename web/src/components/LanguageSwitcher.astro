---
import { LOCALES, type Locale, type LocalePaths } from '../cms/types'

interface Props {
  lang: Locale
  paths?: LocalePaths
  label: string
}

const { lang, paths, label } = Astro.props

const links = LOCALES.map((code) => ({
  code,
  href: paths?.[code] ?? `/${code}`,
  active: code === lang,
}))
---

<nav aria-label={label} class="flex gap-2 text-sm uppercase tracking-wide">
  {
    links.map((link, i) => (
      <>
        {i > 0 && <span class="text-gray-300">/</span>}
        <a
          href={link.href}
          hreflang={link.code}
          aria-current={link.active ? 'page' : undefined}
          class:list={['transition-colors', link.active ? 'font-semibold text-gray-900' : 'text-gray-500 hover:text-gray-900']}
        >
          {link.code}
        </a>
      </>
    ))
  }
</nav>
