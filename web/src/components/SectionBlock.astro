---
import type { Page } from '@astroload/cms/src/payload-types'

import FormBlock from './blocks/FormBlock.astro'
import ImageBlock from './blocks/ImageBlock.astro'
import RichTextBlock from './blocks/RichTextBlock.astro'

type Section = NonNullable<Page['sections']>[number]

interface Props {
  block: Section
}

const { block } = Astro.props
---

{
  block.blockType === 'richText' ? (
    <RichTextBlock {...block} />
  ) : block.blockType === 'image' ? (
    <ImageBlock {...block} />
  ) : block.blockType === 'form' ? (
    <FormBlock {...block} />
  ) : (
    (() => {
      throw new Error(`Section block "${(block as { blockType: string }).blockType}" not implemented`)
    })()
  )
}
