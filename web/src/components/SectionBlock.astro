---
import type { Labels, Page } from '@astroload/cms/src/payload-types'

import type { Locale } from '../cms/types'
import AuthorsListBlock from './blocks/AuthorsListBlock.astro'
import FormBlock from './blocks/FormBlock.astro'
import ImageBlock from './blocks/ImageBlock.astro'
import PostsListBlock from './blocks/PostsListBlock.astro'
import RichTextBlock from './blocks/RichTextBlock.astro'

type Section = NonNullable<Page['sections']>[number]

interface Props {
  block: Section
  lang: Locale
  labels: Labels
}

const { block, lang, labels } = Astro.props
---

{block.blockType === 'richText' && <RichTextBlock {...block} />}
{block.blockType === 'image' && <ImageBlock {...block} />}
{block.blockType === 'form' && <FormBlock {...block} labels={labels.form} />}
{block.blockType === 'postsList' && <PostsListBlock {...block} lang={lang} emptyLabel={labels.lists.noPosts} />}
{block.blockType === 'authorsList' && <AuthorsListBlock {...block} emptyLabel={labels.lists.noAuthors} />}
