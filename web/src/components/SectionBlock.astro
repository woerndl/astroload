---
import type { Labels, Page } from '@astroload/cms/src/payload-types'

import type { Locale } from '../cms/types'
import AuthorsListBlock from './blocks/AuthorsListBlock.astro'
import FormBlock from './blocks/FormBlock.astro'
import ImageBlock from './blocks/ImageBlock.astro'
import PostsListBlock from './blocks/PostsListBlock.astro'
import RichTextBlock from './blocks/RichTextBlock.astro'

type Section = NonNullable<Page['sections']>[number]

// The CMS section-block list and this map must stay in step: `satisfies`
// fails the build until every block type in the union has a renderer. The
// template below dispatches through the destructured names so each block
// keeps its own typed props.
const renderers = {
  richText: RichTextBlock,
  image: ImageBlock,
  form: FormBlock,
  postsList: PostsListBlock,
  authorsList: AuthorsListBlock,
} satisfies Record<Section['blockType'], unknown>

const { richText: RichText, image: Image, form: Form, postsList: PostsList, authorsList: AuthorsList } = renderers

interface Props {
  block: Section
  lang: Locale
  labels: Labels
}

const { block, lang, labels } = Astro.props
---

{block.blockType === 'richText' && <RichText {...block} />}
{block.blockType === 'image' && <Image {...block} />}
{block.blockType === 'form' && <Form {...block} labels={labels.form} />}
{block.blockType === 'postsList' && <PostsList {...block} lang={lang} emptyLabel={labels.lists.noPosts} />}
{block.blockType === 'authorsList' && <AuthorsList {...block} emptyLabel={labels.lists.noAuthors} />}
