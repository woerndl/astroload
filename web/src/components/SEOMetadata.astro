---
import type { Media, SiteSetting } from '@astroload/cms/src/payload-types'

import {
  DEFAULT_LOCALE,
  isPopulated,
  LOCALES,
  MULTIPLE_LOCALES,
  type Locale,
  type LocalePaths,
  type PageCollectionSlug,
} from '../cms/types'
import { absoluteSiteURL, versionedMediaURL } from '../cms/urls'

interface Props {
  lang: Locale
  collection?: PageCollectionSlug
  paths?: LocalePaths
  title: string
  description?: string
  image?: Media | null
  siteSettings: SiteSetting
  preview?: boolean
}

// Keyed by string, not Locale, so the map can list locales a single-locale
// build no longer ships without tripping the type checker. A locale missing
// from the map omits the og:locale tag: the territory half cannot be derived
// from the language (en maps to en_US, not en_EN), so add new locales here.
const OG_LOCALE: Record<string, string> = { de: 'de_DE', en: 'en_US' }

const { lang, collection, paths, title, description, image, siteSettings, preview } = Astro.props

const suffix = siteSettings.defaultSeo?.titleSuffix ?? ''
const fullTitle = title ? `${title}${suffix}` : siteSettings.siteName

const finalDescription = description ?? siteSettings.defaultSeo?.description ?? undefined

const defaultImage = isPopulated<Media>(siteSettings.defaultSeo?.image) ? siteSettings.defaultSeo.image : null
const ogMedia = image ?? defaultImage
const ogVariant = ogMedia?.sizes?.og
const ogUrlPath = ogVariant?.url ?? ogMedia?.url ?? null
const ogImageURL = ogUrlPath ? versionedMediaURL(ogUrlPath, ogMedia?.updatedAt) : null
const ogImageWidth = ogVariant?.width ?? ogMedia?.width ?? null
const ogImageHeight = ogVariant?.height ?? ogMedia?.height ?? null
const ogImageAlt = ogMedia?.alt ?? title

const canonicalPath = paths?.[lang]
const canonicalURL = absoluteSiteURL(canonicalPath ?? Astro.url.pathname)

const ogType = collection === 'posts' ? 'article' : 'website'
const ogLocale = OG_LOCALE[lang]

const allowIndexing = siteSettings.robots?.allowIndexing === true
---

<title>{fullTitle}</title>
{finalDescription && <meta name="description" content={finalDescription} />}
{/* Preview renders under /preview and must not present itself as the public
    page: no canonical, no hreflang alternates, no og:url. */}
{!preview && <link rel="canonical" href={canonicalURL} />}
{!allowIndexing && <meta name="robots" content="noindex, nofollow" />}

{!preview &&
  MULTIPLE_LOCALES &&
  paths &&
  LOCALES.map((code) => {
    const altPath = paths[code]
    if (!altPath) return null
    return <link rel="alternate" hreflang={code} href={absoluteSiteURL(altPath)} />
  })}
{!preview && MULTIPLE_LOCALES && paths?.[DEFAULT_LOCALE] && (
  <link rel="alternate" hreflang="x-default" href={absoluteSiteURL(paths[DEFAULT_LOCALE]!)} />
)}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
{finalDescription && <meta property="og:description" content={finalDescription} />}
{!preview && <meta property="og:url" content={canonicalURL} />}
<meta property="og:site_name" content={siteSettings.siteName} />
{ogLocale && <meta property="og:locale" content={ogLocale} />}
{ogImageURL && (
  <>
    <meta property="og:image" content={ogImageURL} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta property="og:image:alt" content={ogImageAlt} />
  </>
)}

<meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
{finalDescription && <meta name="twitter:description" content={finalDescription} />}
{ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
