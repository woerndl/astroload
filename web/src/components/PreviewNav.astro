<script>
  import { LOCALES } from '@astroload/cms/src/site-config'

  const locales: readonly string[] = LOCALES

  const toPreview = (pathname: string) => {
    const currentLang = location.pathname.split('/').filter(Boolean)[1] // /preview/{lang}/...
    const parts = pathname.split('/').filter(Boolean)
    const first = parts[0] ?? ''
    const prefixed = locales.includes(first)
    const lang = prefixed ? first : currentLang
    const rest = (prefixed ? parts.slice(1) : parts).join('/')
    return `/preview/${lang}${rest ? '/' + rest : ''}`
  }

  // A previewed page renders links in their stored form, with or without the
  // locale prefix, so a plain click leaves preview for the published route.
  // This capture listener rewrites the link to the matching
  // /preview/{lang}/... URL and keeps the secret. In a project that adds
  // <ClientRouter />, this listener stays on document after a swap to a public
  // page, so it reads the current URL on each click and does nothing outside
  // /preview/.
  document.addEventListener(
    'click',
    (event) => {
      if (!location.pathname.startsWith('/preview/')) return
      if (event.defaultPrevented || event.button !== 0) return
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
      const anchor =
        event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null
      if (
        !anchor ||
        (anchor.target && anchor.target !== '_self') ||
        anchor.hasAttribute('download')
      )
        return
      const url = new URL(anchor.href, location.href)
      if (url.origin !== location.origin || url.pathname.startsWith('/preview/')) return

      event.preventDefault()
      const dest = new URL(toPreview(url.pathname) + url.search + url.hash, location.origin)
      const secret = new URLSearchParams(location.search).get('previewSecret')
      if (secret) dest.searchParams.set('previewSecret', secret)
      location.assign(dest.toString())
    },
    true,
  )
</script>
