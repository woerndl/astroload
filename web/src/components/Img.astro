---
import type { Media } from '@astroload/cms/src/payload-types'

import { versionedMediaURL } from '../cms/urls'

type SizeKey = 'xs' | 'sm' | 'md' | 'lg'

interface Props {
  image: Media
  size?: SizeKey
  // Required so every call site states the rendered width. A 100vw default
  // selects oversized variants for any image narrower than the viewport.
  sizes: string
  class?: string
  loading?: 'lazy' | 'eager'
}

// Width-ascending variants for the responsive srcset. og is a fixed social crop
// with a different aspect ratio, so it is left out.
const SRCSET_KEYS: SizeKey[] = ['xs', 'sm', 'md', 'lg']

const { image, size = 'md', sizes, class: className, loading = 'lazy' } = Astro.props

const variant = image.sizes?.[size]
const url = variant?.url ?? image.url
const width = variant?.width ?? image.width
const height = variant?.height ?? image.height

if (!url) {
  throw new Error(`Media ${image.id} has no url`)
}

const srcset = SRCSET_KEYS.flatMap((key) => {
  const v = image.sizes?.[key]
  return v?.url && v.width ? [`${versionedMediaURL(v.url, image.updatedAt)} ${v.width}w`] : []
})
const src = versionedMediaURL(url, image.updatedAt)
---

<img
  src={src}
  srcset={srcset.length ? srcset.join(', ') : undefined}
  sizes={srcset.length ? sizes : undefined}
  alt={image.alt ?? ''}
  width={width}
  height={height}
  loading={loading}
  class={className}
/>
