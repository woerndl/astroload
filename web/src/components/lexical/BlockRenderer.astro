---
import type { BlockNode, InlineBlockNode } from '@jhb.software/astro-payload-richtext-lexical'

import type { ImageBlock as ImageBlockType } from '@astroload/cms/src/payload-types'

import ImageBlock from '../blocks/ImageBlock.astro'

interface Props {
  node: BlockNode | InlineBlockNode
  inline?: boolean
}

// The lexical editor's BlocksFeature allows only these block types. Adding one
// there means adding it here too: `satisfies` fails the build until every type
// in the union has a renderer, so the map can't silently miss a union entry.
type LexicalBlockType = 'image'

const renderers = {
  image: ImageBlock,
} satisfies Record<LexicalBlockType, unknown>

const { node } = Astro.props
const { fields } = node

if (!(fields.blockType in renderers)) {
  throw new Error(`Lexical block "${fields.blockType}" not implemented`)
}

const Renderer = renderers[fields.blockType as LexicalBlockType]
const blockFields = fields as unknown as ImageBlockType
---

<Renderer {...blockFields} />
