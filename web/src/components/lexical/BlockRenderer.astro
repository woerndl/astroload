---
import type { BlockNode, InlineBlockNode } from '@jhb.software/astro-payload-richtext-lexical'

import type { ImageBlock as ImageBlockType } from '@astroload/cms/src/payload-types'

import ImageBlock from '../blocks/ImageBlock.astro'

interface Props {
  node: BlockNode | InlineBlockNode
  inline?: boolean
}

const { node } = Astro.props
const { fields } = node

if (fields.blockType !== 'image') {
  throw new Error(`Lexical block "${fields.blockType}" not implemented`)
}

const imageFields = fields as unknown as ImageBlockType
---

<ImageBlock {...imageFields} />
