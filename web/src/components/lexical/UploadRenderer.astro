---
import type { UploadNode } from '@jhb.software/astro-payload-richtext-lexical'

import type { Media } from '@astroload/cms/src/payload-types'

import { isPopulated } from '../../cms/types'
import Img from '../Img.astro'

type Props = { node: UploadNode }

const { node } = Astro.props
---

{
  node.relationTo === 'media' && isPopulated(node.value) ? (
    <Img
      image={node.value as unknown as Media}
      size="md"
      class="my-6 w-full"
      sizes="(min-width: 768px) 736px, 100vw"
    />
  ) : null
}
