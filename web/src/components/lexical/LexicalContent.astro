---
import type { LexicalNode } from '@jhb.software/astro-payload-richtext-lexical'
import RichTextLexical from '@jhb.software/astro-payload-richtext-lexical/RichTextLexical.astro'

import BlockRenderer from './BlockRenderer.astro'
import { sanitizeLexicalLinks } from './sanitizeLinks'
import UploadRenderer from './UploadRenderer.astro'

interface Props {
  content:
    | {
        root: {
          children: LexicalNode[]
          [k: string]: unknown
        }
        [k: string]: unknown
      }
    | null
    | undefined
  class?: string
}

const { content, class: className } = Astro.props
// A draft with an untouched body has no content yet; render nothing rather than
// dereferencing a null root.
const nodes = sanitizeLexicalLinks(content?.root?.children ?? [])
---

<RichTextLexical
  nodes={nodes}
  UploadRenderer={UploadRenderer}
  BlockRenderer={BlockRenderer}
  class:list={[className]}
/>
