---
import type { ImageBlock as ImageBlockType } from '@astroload/cms/src/payload-types'

import { isPopulated } from '../../cms/types'
import { CONTENT_COLUMN_SIZES } from '../../layout/contentColumn'
import Img from '../Img.astro'

type Props = Omit<ImageBlockType, 'blockType'>

const { image, caption } = Astro.props
const media = isPopulated(image) ? image : null
---

{media && (
  <figure class="figure">
    <Img image={media} size="md" class="image" sizes={CONTENT_COLUMN_SIZES} />
    {caption && <figcaption class="caption">{caption}</figcaption>}
  </figure>
)}

<style>
  @layer components {
    .figure {
      margin-block: 1.5rem;
    }

    .image {
      inline-size: 100%;
    }

    .caption {
      margin-top: 0.5rem;
      color: var(--color-text-muted);
    }
  }
</style>
