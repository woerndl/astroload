---
import type {
  Author,
  AuthorsListBlock as AuthorsListBlockType,
} from '@astroload/cms/src/payload-types'

import { isPopulated } from '../../cms/types'
import Img from '../Img.astro'

type Props = Omit<AuthorsListBlockType, 'blockType'> & { emptyLabel: string }

const { authors, emptyLabel } = Astro.props
const items = (authors ?? []).filter((a): a is Author => isPopulated(a))
---

{items.length === 0 ? (
  <p class="empty">{emptyLabel}</p>
) : (
  <ul class="list">
    {items.map((author) => {
      const photo = isPopulated(author.photo) ? author.photo : null
      return (
        <li>
          <a href={author.path} class="item">
            {photo && (
              <div class="photo">
                <Img image={photo} size="sm" class="avatar" sizes="80px" />
              </div>
            )}
            <div class="text">
              <h3 class="name">{author.name}</h3>
              {author.role && <p class="role">{author.role}</p>}
            </div>
          </a>
        </li>
      )
    })}
  </ul>
)}

<style>
  @layer components {
    .empty {
      margin-block: 1.5rem;
      color: var(--color-text-subtle);
    }

    .list {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      margin-block: 1.5rem;
    }

    .item {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .photo {
      flex-shrink: 0;
      inline-size: 5rem;
    }

    .avatar {
      inline-size: 100%;
      aspect-ratio: 1;
      border-radius: 50%;
      object-fit: cover;
    }

    .text {
      flex: 1;
    }

    .name {
      font-weight: 600;
    }

    .item:hover .name {
      text-decoration: underline;
    }

    .role {
      margin-top: 0.25rem;
      color: var(--color-text-muted);
    }
  }
</style>
