---
import type { Author, AuthorsListBlock as AuthorsListBlockType } from '@astroload/cms/src/payload-types'

import { isPopulated } from '../../cms/types'
import Img from '../Img.astro'

type Props = Omit<AuthorsListBlockType, 'blockType'> & { emptyLabel: string }

const { authors, emptyLabel } = Astro.props
const items = (authors ?? []).filter((a): a is Author => isPopulated(a))
---

{
  items.length === 0 ? (
    <p class="my-6 text-gray-500">{emptyLabel}</p>
  ) : (
    <ul class="my-6 flex flex-col gap-6">
      {items.map((author) => {
        const photo = isPopulated(author.photo) ? author.photo : null
        return (
          <li>
            <a href={author.path} class="flex gap-4 group items-center">
              {photo && (
                <div class="w-20 shrink-0">
                  <Img
                    image={photo}
                    size="sm"
                    class="aspect-square w-full rounded-full object-cover"
                    sizes="80px"
                  />
                </div>
              )}
              <div class="flex-1">
                <h3 class="font-semibold group-hover:underline">{author.name}</h3>
                {author.role && <p class="mt-1 text-gray-600">{author.role}</p>}
              </div>
            </a>
          </li>
        )
      })}
    </ul>
  )
}
