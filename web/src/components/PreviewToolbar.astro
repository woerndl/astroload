---
import type { Labels } from '@astroload/cms/src/payload-types'

import type { PreviewContext } from '../cms/types'
import { absoluteCmsURL } from '../cms/urls'

interface Props extends PreviewContext {
  labels: Labels['preview']
}

const { collection, id, labels } = Astro.props

// Safari before 16.4 sends no Sec-Fetch-Dest, so there the toolbar also
// renders inside the admin live-preview iframe. Acceptable degradation for an
// editor-only surface.
const insideIframe = Astro.request.headers.get('sec-fetch-dest') === 'iframe'
const adminHref = absoluteCmsURL(`/admin/collections/${collection}/${id}`)
---

{
  !insideIframe && (
    <div
      class="sticky top-0 z-50 flex items-center justify-between border-b border-amber-300 bg-amber-50 px-4 py-2 text-sm text-amber-900 shadow"
      role="status"
    >
      <span>{labels.editingDraft}</span>
      <a href={adminHref} class="inline-flex min-h-6 items-center font-medium underline hover:no-underline">
        {labels.openInAdmin}
      </a>
    </div>
  )
}
