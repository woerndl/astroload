---
import type { Header, Labels } from '@astroload/cms/src/payload-types'

import {
  MULTIPLE_LOCALES,
  resolveNavLinks,
  stripLocalePath,
  type Locale,
  type LocalePaths,
} from '../cms/types'
import LanguageSwitcher from './LanguageSwitcher.astro'

interface Props {
  header: Header
  lang: Locale
  paths?: LocalePaths
  labels: Labels['global']
}

const { header, lang, paths, labels } = Astro.props

const links = resolveNavLinks(header.links)
const homeHref = stripLocalePath(`/${lang}`)
---

<header class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
  <a href={homeHref} class="font-semibold">{labels.home}</a>
  <div class="flex items-center gap-6">
    {
      links.length > 0 && (
        <nav>
          <ul class="flex gap-4 text-gray-600">
            {links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {MULTIPLE_LOCALES && <LanguageSwitcher lang={lang} paths={paths} label={labels.language} />}
  </div>
</header>
