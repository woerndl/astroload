---
import type { Header, Labels } from '@astroload/cms/src/payload-types'

import {
  MULTIPLE_LOCALES,
  resolveNavLinks,
  stripLocalePath,
  type Locale,
  type LocalePaths,
} from '../cms/types'
import LanguageSwitcher from './LanguageSwitcher.astro'

interface Props {
  header: Header
  lang: Locale
  paths?: LocalePaths
  labels: Labels['global']
  navLabel: string
}

const { header, lang, paths, labels, navLabel } = Astro.props

const links = resolveNavLinks(header.links)
const homeHref = stripLocalePath(`/${lang}`)
---

<header class="header">
  <a href={homeHref} class="home">
    {labels.home}
  </a>
  <div class="end">
    {links.length > 0 && (
      <nav aria-label={navLabel}>
        <ul class="links">
          {links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    {MULTIPLE_LOCALES && <LanguageSwitcher lang={lang} paths={paths} label={labels.language} />}
  </div>
</header>

<style>
  @layer components {
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: var(--content-width);
      margin-inline: auto;
      padding: 1rem;
    }

    .home {
      font-weight: 600;
    }

    .end {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .links {
      display: flex;
      gap: 1rem;
      color: var(--color-text-muted);
    }
  }
</style>
